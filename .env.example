# Database
# Matches docker-compose.dev.yml; for a local Postgres outside compose, use your own credentials.
DATABASE_URL="postgresql://dev:dev@localhost:5432/depsight_dev"

# Postgres password of the production compose files (docker-compose.yml, docker-compose.traefik.yml);
# not used by docker-compose.dev.yml. One value feeds the database and the app's DATABASE_URL. Use a
# URL-safe value (openssl rand -hex 24). docker-compose.yml refuses to start without it; the traefik
# file falls back to the hosted database's current password. Rotation: docs/configuration.md.
# POSTGRES_PASSWORD=""

# GitHub OAuth (https://github.com/settings/developers); the callback URL is <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Background auto-scan
SCAN_INTERVAL_MINUTES="60"  # Optional: minutes between automatic re-scans (default 60)
# Milliseconds a RUNNING CVE scan counts as in progress; a new scan of the same repository inside the window returns it (default 300000).
# SCAN_RUNNING_WINDOW_MS="300000"

# PR scan webhook secrets (optional). Each tracked repository gets its own secret in
# Settings; they are stored sealed (AES-256-GCM) under a key derived from this value, or
# from NEXTAUTH_SECRET when this is empty. Set it before creating the first secret and
# keep it: changing it makes the stored secrets unreadable until they are rotated.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_KEY=""
# Instance default for pull requests from forks: ignored unless "true" (only where fork contributors are trusted).
# A repository owner can override it per tracked repository in Settings.
# GITHUB_WEBHOOK_SCAN_FORKS="false"
# Set to "true" to switch the PR scan webhook off (the endpoint answers 404 and reads nothing).
# GITHUB_WEBHOOK_DISABLED="false"
# Trusted reverse proxies in front of the app; the webhook's per-address rate limit reads the
# client address from that hop of X-Forwarded-For, counted from the right. 1 = traefik (default),
# 0 = ignore the header (every caller shares one bucket, use when the app is reached directly).
# The same address decides whether a request counts against the separate budget of GitHub's hook
# ranges (fetched from api.github.com/meta, so the app needs outbound HTTPS to it). With 0 no
# request is classified as a hook address, nothing is fetched and all callers share the ceiling.
# WEBHOOK_TRUSTED_PROXY_HOPS="1"
