# Database
DATABASE_URL="postgresql://depsight:password@localhost:5432/depsight"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Background auto-scan
SCAN_INTERVAL_MINUTES="60"  # Optional: minutes between automatic re-scans (default 60)

# PR scan webhook secrets (optional). Each tracked repository gets its own secret in
# Settings; they are stored sealed (AES-256-GCM) under a key derived from this value, or
# from NEXTAUTH_SECRET when this is empty. Set it before creating the first secret and
# keep it: changing it makes the stored secrets unreadable until they are rotated.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_KEY=""
# Pull requests from forks are ignored by default; set to "true" to scan them too (only where fork contributors are trusted).
# GITHUB_WEBHOOK_SCAN_FORKS="false"
# Set to "true" to switch the PR scan webhook off (the endpoint answers 404 and reads nothing).
# GITHUB_WEBHOOK_DISABLED="false"
# Trusted reverse proxies in front of the app; the webhook's per-address rate limit reads the
# client address from that hop of X-Forwarded-For, counted from the right. 1 = traefik (default),
# 0 = ignore the header (every caller shares one bucket, use when the app is reached directly).
# WEBHOOK_TRUSTED_PROXY_HOPS="1"
