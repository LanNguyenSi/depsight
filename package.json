{
  "name": "depsight",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:pre-push": "prisma db execute --file prisma/pre-push/advisory-unique-key.sql --schema prisma/schema.prisma",
    "db:push": "npm run db:pre-push && prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "semver": "^7.8.5",
    "spdx-license-list": "^6.12.0",
    "spdx-satisfies": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": ">=3.20.0",
    "defu": ">=6.1.5",
    "postcss": "$postcss",
    "esbuild": ">=0.28.1",
    "sharp": "^0.35.4"
  }
}
